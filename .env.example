# Copy this file to ".env" (in this folder or in the PeerMindAI folder) and fill in your own values.
# .env is listed in .gitignore, so it is never committed. Do not put it in a ZIP you share.

# AI features: one of the two keys is enough.
# Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic (Claude): https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: which provider to use when both keys are filled in (Groq or Anthropic)
# AI_PROVIDER=Groq
# Optional: another model than the default (openai/gpt-oss-120b for Groq, claude-haiku-5-5 for Anthropic)
# AI_MODEL=

# Optional: your database connection if it differs from appsettings.json
# DB_CONNECTION=Server=localhost;Port=3306;Database=peermindai_db;User ID=root;Password=;
