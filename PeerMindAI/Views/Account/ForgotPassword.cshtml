@model ForgotPasswordForm
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Forgot password";
    var sent = ViewBag.Sent == true;
}
<div class="center">
    <div class="card" style="max-width:440px;width:100%;padding:36px">
        <div class="c mb"><span class="ico" style="width:56px;height:56px">@Ui.Icon(sent ? "mail" : "lock", 26)</span></div>

        @if (sent)
        {
            <div class="c">
                <h1 style="font-size:26px">Check your email</h1>
                <p class="sub mt1 mb">If an account exists for <b>@Model.Email</b>, we sent it a link to reset the password. The link expires in 30 minutes.</p>
            </div>
            <div class="alert alert-info">
                Demo note: this project has no mail server, so the e-mail is printed in the terminal where the application runs. Copy the link from there.
            </div>
            <a class="btn btn-pri btn-block" asp-action="Login">Back to log in</a>
        }
        else
        {
            <h1 class="c" style="font-size:26px">Forgot password?</h1>
            <p class="sub c mb mt1">Enter your university email and we’ll send reset instructions.</p>
            <partial name="_FormErrors" />
            <form asp-action="ForgotPassword" method="post" novalidate data-validate>
                <div class="field">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="in" placeholder="you@university.edu" autocomplete="email" autofocus>
                    <span asp-validation-for="Email" class="err"></span>
                </div>
                <button type="submit" class="btn btn-pri btn-block btn-lg">Send reset link</button>
            </form>
        }
        <p class="c" style="margin-top:22px"><a class="sm b" style="color:var(--pri)" asp-action="Login">← Back to log in</a></p>
    </div>
</div>
