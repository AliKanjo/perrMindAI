@model ResetPasswordForm
@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Choose a new password";
}
<div class="center">
    <div class="card" style="max-width:440px;width:100%;padding:36px">
        <div class="c mb"><span class="ico" style="width:56px;height:56px">@Ui.Icon("lock", 26)</span></div>
        <h1 class="c" style="font-size:26px">Choose a new password</h1>
        <p class="sub c mb mt1">For <b>@Model.Email</b></p>

        <partial name="_FormErrors" />
        <form asp-action="ResetPassword" method="post" novalidate data-validate>
            <input type="hidden" asp-for="Token">
            <div class="field">
                <label asp-for="NewPassword"></label>
                <input asp-for="NewPassword" class="in" placeholder="At least 10 characters" autocomplete="new-password" autofocus>
                <span asp-validation-for="NewPassword" class="err"></span>
                <span class="hint">Use upper and lower case letters, a number and a symbol.</span>
            </div>
            <div class="field">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="in" autocomplete="new-password">
                <span asp-validation-for="ConfirmPassword" class="err"></span>
            </div>
            <button type="submit" class="btn btn-pri btn-block btn-lg">Save new password</button>
        </form>
    </div>
</div>
