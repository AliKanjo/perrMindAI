@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "Link not valid";
}
<div class="center">
    <div class="card c" style="max-width:440px;width:100%;padding:36px">
        <span class="ico bad" style="width:56px;height:56px">@Ui.Icon("x", 26)</span>
        <h1 style="font-size:26px;margin-top:18px">This link is not valid</h1>
        <p class="sub mt1">The password reset link was already used or has expired. Reset links work once and for 30 minutes.</p>
        <a class="btn btn-pri btn-block btn-lg" style="margin-top:22px" asp-action="ForgotPassword">Request a new link</a>
        <p style="margin-top:16px"><a class="sm b" style="color:var(--pri)" asp-action="Login">← Back to log in</a></p>
    </div>
</div>
