@model CourseListPage
@{
    ViewData["Title"] = "Course library";
    ViewData["Nav"] = "courses";
}
<div class="ph">
    <div><h1>Course library</h1><p>Create, edit and remove the courses that tutors can teach.</p></div>
    <div class="row wrap"><a class="btn btn-pri" href="/admin/courses/create">@Ui.Icon("plus") Add course</a></div>
</div>

<div class="card mb">
    <form method="get" action="/admin/courses" class="row wrap">
        <input class="in grow" name="q" value="@Model.Search" placeholder="Search by course name or code…" maxlength="100" style="min-width:220px" aria-label="Search courses">
        <button type="submit" class="btn btn-pri">@Ui.Icon("search") Search</button>
        @if (Model.Search != null)
        {
            <a class="btn btn-sec" href="/admin/courses">Clear</a>
        }
    </form>
</div>

<div class="card flat">
    @if (Model.Courses.Count == 0)
    {
        <div class="empty">
            <span class="ico">@Ui.Icon("lib", 20)</span>
            <h3>@(Model.Search == null ? "The course library is empty" : "No courses match your search")</h3>
            <p class="sm">@(Model.Search == null ? "Add the first course to get started." : "Try another name or course code.")</p>
        </div>
    }
    else
    {
        <table>
            <thead><tr><th>Course</th><th>Department</th><th>Professor</th><th>Students</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var course in Model.Courses)
                {
                    <tr>
                        <td>
                            <div class="row">
                                <span class="ico" style="width:34px;height:34px">@Ui.Icon("book", 16)</span>
                                <div><b>@course.Name</b><div class="xs sub">@course.Code</div></div>
                            </div>
                        </td>
                        <td>@(course.Department ?? "—")</td>
                        <td>@(course.Professor ?? "—")</td>
                        <td>@course.Students</td>
                        <td>@(course.IsActive ? Ui.Badge("Active", "ok") : Ui.Badge("Inactive", "gray"))</td>
                        <td>
                            <div class="row" style="justify-content:flex-end">
                                <a class="btn btn-sec btn-sm" href="/admin/courses/@course.CourseId/edit">Edit</a>
                                <form method="post" action="/admin/courses/@course.CourseId/delete"
                                      data-confirm="Delete &quot;@course.Name&quot;? A course that is in use is only deactivated.">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-bad btn-sm">Delete</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
<p class="xs sub mt1">@Model.Courses.Count course(s)</p>
