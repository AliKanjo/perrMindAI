@model TutorProfilePage
@{
    var tutor = Model.Tutor;
    ViewData["Title"] = tutor.FullName;
    ViewData["Nav"] = "tutors";
    var slotsByDay = tutor.FreeSlots.GroupBy(slot => slot.StartAt.Date).ToList();
}
<a class="sm b row mb" style="color:var(--pri)" href="/tutors">@Ui.Icon("left") Back to tutors</a>

<div class="g21">
    <div class="col">
        <div class="card">
            <div class="row" style="gap:18px">
                @Ui.Avatar(tutor.FullName, 76)
                <div class="grow">
                    <h1 style="font-size:24px">@tutor.FullName @Ui.Badge("✓ Verified", "ok")</h1>
                    <p class="sub">@tutor.Headline · @tutor.University</p>
                    <p class="sm" style="margin-top:6px">@Ui.Stars(tutor.AverageRating) <span class="sub">(@tutor.ReviewCount reviews)</span> · <b>@Ui.Money(tutor.HourlyRate)/hr</b></p>
                </div>
            </div>
            <hr class="hr">
            <h3>About</h3>
            <p class="sm sub">@(string.IsNullOrWhiteSpace(tutor.Bio) ? "This tutor has not written a bio yet." : tutor.Bio)</p>
        </div>

        <div class="card">
            <h3>Qualifications</h3>
            <div class="col" style="margin-top:8px">
                <div class="row sm">@Ui.Icon("check") @tutor.Degree @tutor.Major, @tutor.University</div>
                <div class="row sm">@Ui.Icon("check") Transcript verified by PeerMindAI</div>
            </div>
            <div class="row wrap" style="margin-top:14px">
                @foreach (var course in tutor.Courses)
                {
                    @Ui.Badge(course.Name, "pri")
                }
            </div>
        </div>

        <div class="card">
            <h3>Reviews</h3>
            @if (tutor.Reviews.Count == 0)
            {
                <p class="sm sub mt1">No reviews yet. Be the first to book a session.</p>
            }
            @foreach (var review in tutor.Reviews)
            {
                <div class="li" style="align-items:flex-start">
                    @Ui.Avatar(review.StudentName, 38)
                    <div>
                        <div class="b sm">@review.StudentName <span style="color:#F59E0B">@Ui.StarRow(review.Rating)</span> <span class="xs sub" style="font-weight:400">@Ui.Ago(review.CreatedAt)</span></div>
                        <div class="sm sub">@review.Comment</div>
                        @if (!string.IsNullOrEmpty(review.TutorReply))
                        {
                            <div class="sm" style="margin-top:6px;padding:8px 12px;background:#F8FAFC;border-radius:10px"><b>@Ui.FirstName(tutor.FullName):</b> @review.TutorReply</div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="card" style="align-self:start;position:sticky;top:90px">
        <h3>Book a session</h3>
        @if (tutor.FreeSlots.Count == 0)
        {
            <div class="empty" style="padding:24px 0">
                <span class="ico warn">@Ui.Icon("clock", 20)</span>
                <h3>No free time slots</h3>
                <p class="sm">This tutor has no open availability right now. Please check again later.</p>
            </div>
        }
        else
        {
            <p class="sub sm mb">Pick a day and time</p>
            <partial name="_FormErrors" />

            <form method="post" action="/bookings" novalidate data-validate id="booking-form" data-rate="@tutor.HourlyRate.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                @Html.AntiForgeryToken()
                <input type="hidden" name="TutorId" value="@tutor.TutorId">

                <div class="row wrap mb" id="day-chips">
                    @for (var i = 0; i < slotsByDay.Count; i++)
                    {
                        <button type="button" class="chip @(i == 0 ? "on" : "")" data-day="@i">@slotsByDay[i].Key.ToString("ddd d MMM")</button>
                    }
                </div>

                <div class="field">
                    @for (var i = 0; i < slotsByDay.Count; i++)
                    {
                        <div class="g2 @(i == 0 ? "" : "hide")" style="gap:8px" data-day-panel="@i">
                            @foreach (var slot in slotsByDay[i])
                            {
                                <label class="slot">
                                    <input type="radio" name="SlotId" value="@slot.SlotId"
                                           data-minutes="@((int)(slot.EndAt - slot.StartAt).TotalMinutes)"
                                           data-val="true" data-val-required="Please pick a time slot."
                                           checked="@(Model.Form.SlotId == slot.SlotId)">
                                    @Ui.TimeRange(slot.StartAt, slot.EndAt)
                                </label>
                            }
                        </div>
                    }
                    <span class="err" data-valmsg-for="SlotId">@Html.ValidationMessage("SlotId")</span>
                </div>

                <div class="field">
                    <label for="CourseId">Course</label>
                    <select class="sel in" id="CourseId" name="CourseId" data-val="true" data-val-required="Please choose a course.">
                        @if (tutor.Courses.Count != 1)
                        {
                            <option value="">Choose a course…</option>
                        }
                        @foreach (var course in tutor.Courses)
                        {
                            <option value="@course.CourseId" selected="@(Model.Form.CourseId == course.CourseId)">@course.Name</option>
                        }
                    </select>
                    <span class="err" data-valmsg-for="CourseId">@Html.ValidationMessage("CourseId")</span>
                </div>
                <div class="field">
                    <label for="Topic">Topic (optional)</label>
                    <input class="in" id="Topic" name="Topic" value="@Model.Form.Topic" maxlength="150" placeholder="e.g. Exam preparation"
                           data-val="true" data-val-length="The topic can have at most 150 characters." data-val-length-max="150">
                    <span class="err" data-valmsg-for="Topic">@Html.ValidationMessage("Topic")</span>
                </div>
                <div class="field">
                    <label for="Notes">Notes (optional)</label>
                    <textarea class="in" id="Notes" name="Notes" maxlength="1000" placeholder="What do you want to focus on?"
                              data-val="true" data-val-length="The notes can have at most 1000 characters." data-val-length-max="1000">@Model.Form.Notes</textarea>
                    <span class="err" data-valmsg-for="Notes">@Html.ValidationMessage("Notes")</span>
                </div>

                <div class="rowb mb"><span class="sub">Total</span><b id="booking-total">Pick a time</b></div>
                <button type="submit" class="btn btn-pri btn-block btn-lg">Request booking</button>
                <p class="xs sub c" style="margin-top:10px">The tutor confirms your request. Payment is arranged outside the platform.</p>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/booking-form.js" asp-append-version="true"></script>
}
